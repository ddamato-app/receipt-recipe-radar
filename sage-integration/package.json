{
  "name": "sage-300-pos-integration",
  "version": "1.0.0",
  "description": "Windows service that connects to SAGE 300 POS and exposes invoices, payments, and contracts via REST API",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "install-service": "node dist/install.js --install",
    "uninstall-service": "node dist/install.js --uninstall"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "mssql": "^10.0.2",
    "node-cron": "^3.0.3",
    "node-windows": "^1.0.0-beta.8",
    "odbc": "^2.4.9",
    "pdfkit": "^0.14.0",
    "winston": "^3.13.0",
    "axios": "^1.7.2",
    "@supabase/supabase-js": "^2.44.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/mssql": "^9.1.5",
    "@types/node": "^20.14.9",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.13.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  }
}
